{
  "dashboard": {
    "title": "A2A Overview",
    "uid": "a2a-overview",
    "panels": [
      {
        "type": "stat",
        "title": "请求总次数 (1m)",
        "targets": [
          {
            "expr": "sum(increase(http_requests_total[1m]))",
            "legendFormat": "总请求"
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6}
      },
      {
        "type": "stat",
        "title": "成功率 (%)",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=\"200\"}[1m])) / sum(rate(http_requests_total[1m])) * 100",
            "legendFormat": "成功率"
          }
        ],
        "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6}
      },
      {
        "type": "timeseries",
        "title": "P95 延迟 (秒)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, job))",
            "legendFormat": "P95 {{job}}"
          }
        ],
        "gridPos": {"x": 0, "y": 6, "w": 16, "h": 8}
      }
    ],
    "schemaVersion": 38,
    "timepicker": {},
    "timezone": "browser"
  }
}
